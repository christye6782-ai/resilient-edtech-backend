# Copy this file to ".env" and adjust if needed.

# The three AI agents (Analyst, Auditor, FAQ) run on a LOCAL Llama 3.2 3B model
# served by Ollama (https://ollama.com) — nothing leaves the machine.
#
# Setup:
#   1. Install Ollama, then start it (it runs at http://localhost:11434).
#   2. Pull the model:  ollama pull llama3.2:3b
#
# If Ollama isn't running or the model isn't pulled, the app still works using a
# built-in rule-based fallback — answers are just richer with the model running.

# Ollama server address.
OLLAMA_HOST=http://localhost:11434

# Model tag (must be pulled with `ollama pull <tag>`).
OLLAMA_MODEL=llama3.2:3b

# Set to false to force the rule-based fallback (skip the model entirely).
LLM_ENABLED=true

# Generation tuning (optional).
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=180

# Optional: absolute path to the Tesseract OCR executable.
# Only needed on Windows when tesseract.exe is not on your PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
