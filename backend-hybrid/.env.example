# Copy this file to ".env" and adjust if needed.
#
# The three AI agents (Analyst, Auditor, FAQ) can run on THREE tiers:
#   * cloud  — an OpenAI-compatible API (used only when online + key present)
#   * local  — Llama 3.2 3B via Ollama (fully offline, nothing leaves the machine)
#   * basic  — built-in rule-based fallback (no model at all)
#
# ENGINE_MODE decides the policy. In "auto" the app prefers cloud when online,
# falls back to the local model, then to rule-based — so it always answers.

# auto | cloud | local | basic
ENGINE_MODE=auto

# --- Local tier (Ollama) -----------------------------------------------------
# Setup: install Ollama (https://ollama.com), then:  ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Set to false to disable the LOCAL model tier entirely.
LLM_ENABLED=true

# --- Cloud tier (OpenAI-compatible) ------------------------------------------
# Leave CLOUD_API_KEY blank to disable cloud (the app then uses local/basic).
# Works with OpenAI, OpenRouter, Together, or any self-hosted OpenAI-compatible
# gateway — just point CLOUD_BASE_URL at it.
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini
CLOUD_ENABLED=true
CLOUD_TIMEOUT=60
# Max seconds for the online/offline probe used in "auto" mode.
CONNECTIVITY_TIMEOUT=1.5

# --- Generation tuning (shared) ----------------------------------------------
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=180

# Optional: absolute path to the Tesseract OCR executable.
# Only needed on Windows when tesseract.exe is not on your PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
