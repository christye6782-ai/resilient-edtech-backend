# Copy this file to ".env" and adjust if needed.
#
# Localized Offline Agentic AI — everything runs on ONE device, no internet.
# There are two fully-offline engine tiers:
#   * local  — Llama 3.2 3B via Ollama (the on-device model)
#   * basic  — built-in rule-based fallback (no model at all)
#
# ENGINE_MODE decides the policy. There is NO cloud tier and no network call.

# auto | local | basic
#   auto  → on-device Llama if reachable, else rule-based (recommended)
#   local → on-device Llama, else rule-based
#   basic → rule-based only (lowest-spec hardware)
ENGINE_MODE=auto

# --- On-device model (Ollama) ------------------------------------------------
# Setup: install Ollama (https://ollama.com), then:  ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Set to false to force the rule-based engine (skips the model entirely).
LLM_ENABLED=true

# --- Generation tuning -------------------------------------------------------
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=180

# Optional: absolute path to the Tesseract OCR executable.
# Only needed on Windows when tesseract.exe is not on your PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
